# Selects the catalog implementation. Unset or "mock" uses the committed local
# catalog (data/catalog.json) — this is the default, and what the pitch demo runs on.
# Set to "blaze" to read live from the BLAZE ECOM commerce API instead.
CATALOG_SOURCE=mock

# Only read when CATALOG_SOURCE=blaze. Both fall back to the documented staging
# store if unset, so CATALOG_SOURCE=blaze works with no further setup. Server-side
# only — never prefix these with NEXT_PUBLIC_, which would ship them to the browser.
BLAZE_ECOM_BASE_URL=https://ecom-api.staging.blaze.me
BLAZE_ECOM_STORE_UUID=e87437f2-3e35-4738-af5e-6307e368255c
